{
	"name": "copilot-academy",
	"private": true,
	"version": "1.0.0",
	"description": "Copilot Academy — Microsoft 365 Copilot için Türkçe, interaktif ve uygulamalı eğitim simülasyonu",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"browserslist": [
		"chrome >= 109",
		"edge >= 109",
		"firefox >= 115",
		"safari >= 15.4",
		"ios_saf >= 15.4",
		"samsung >= 20"
	],
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"build:embed": "vue-tsc --noEmit && vite build --mode embed",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"echarts": "^6.1.0",
		"lucide-vue-next": "^0.577.0",
		"pinia": "^3.0.4",
		"vue": "^3.5.27",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/test-utils": "~2.4.6",
		"autoprefixer": "^10.4.20",
		"jsdom": "^29.1.1",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.15",
		"typescript": "~5.9.3",
		"vite": "^7.3.0",
		"vitest": "^4.1.7",
		"vue-tsc": "^3.1.0"
	}
}
